# 复制为 .env 并按需填写。demo 模式不需要任何密钥。
# 飞书自建应用(仅当不用 lark-cli、走 REST 兜底时需要)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Resend 发信(仅 week05 真实发送需要;申请步骤见 weeks/week05-email-growth/README.md)
RESEND_API_KEY=

# week06 自动剪辑:OpenAI 兼容 LLM 中转(仅自动打标 / AI 话术需要;demo 和 --mock 不需要)
# LLM_BASE_URL 填中转站根地址,不带 /v1
LLM_API_KEY=
LLM_BASE_URL=

# week06 可选:OpenAI 兼容 TTS(/v1/audio/speech;默认 edge-tts 免费,这两项留空即可)
TTS_API_KEY=
TTS_BASE_URL=
